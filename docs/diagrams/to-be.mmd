flowchart TD
    A["Появляется новая задача"] --> B["Пользователь открывает Todo List"]
    B --> C["Создает задачу"]
    C --> D["Вводит название"]
    D --> E["Добавляет описание при необходимости"]
    E --> F["Выбирает категорию: Работа, Учеба или Личное"]
    F --> G["Указывает дедлайн при необходимости"]
    G --> H["Приложение сохраняет задачу в JSON"]
    H --> I["Пользователь просматривает список задач"]
    I --> J{"Нужно выполнить задачу?"}
    J --> K["Пользователь выполняет задачу"]
    K --> L["Отмечает статус Выполнено"]
    J --> M["Пользователь оставляет задачу активной"]
    L --> N["Список задач остается актуальным"]
    M --> N
